# コピーして wrangler.toml を作成し、自分の値を記入する:
#   cp wrangler.toml.example wrangler.toml
#
# 実値入りの wrangler.toml は .gitignore 済み（誤コミット防止）。
#
# Secrets は wrangler secret put で別途登録する:
#   wrangler secret put WITHINGS_CLIENT_ID      # 任意: Withings連携を使う場合のみ。開発者ポータルのClient ID
#   wrangler secret put WITHINGS_CLIENT_SECRET  # 任意: 同 Client Secret（未設定でも手動記録で全機能が動く）
#   wrangler secret put SLACK_WEBHOOKS          # 例: [{"id":"main","url":"https://hooks.slack.com/services/..."}]
#   wrangler secret put SETUP_SECRET            # 任意: Withings連携時のみ。/auth/start の保護キー（ランダム文字列）
#   wrangler secret put ADMIN_SLACK_WEBHOOK     # 任意: 管理者アラート送信先（未設定時はSLACK_WEBHOOKSの先頭）
#   wrangler secret put GOOGLE_OAUTH_CLIENT_ID      # 書き込みAPI（食事・運動・体重の記録）とMCP用。Google CloudのOAuthクライアントID
#   wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET  # 同 Client Secret
#   wrangler secret put OWNER_EMAILS                # 書き込みを許可するGoogleアカウントのメール（カンマ区切り、例: "a@example.com,b@example.com"）
#   wrangler secret put COACHING_API_SECRET         # 任意: AIコーチングとダイジェスト送り直し（GitHub Actions）用。GitHub Secrets側と同値を登録
#   wrangler secret put OG_ACCESS_TOKEN             # 任意: READ_ACCESS=private時にSlack通知のグラフ画像を通すキー（openssl rand -hex 32）
#   wrangler secret put GITHUB_DISPATCH_TOKEN       # 任意: AIコーチング生成をWorkerから起動する場合のみ。fine-grained PAT（対象リポのActions: Read and write。下のGITHUB_DISPATCH_REPOとセット）

name = "bodylog"
main = "src/index.ts"
compatibility_date = "2026-04-01"

# 任意: 独自ドメインで公開する場合（ゾーンが同じCloudflareアカウントにあること）
# routes = [
#   { pattern = "weight.example.com", custom_domain = true }
# ]

[[d1_databases]]
binding = "DB"
database_name = "bodylog"
database_id = "YOUR_D1_DATABASE_ID" # wrangler d1 create bodylog で表示されるID

# OAuth 2.1（書き込みAPI / MCP用）のトークン・認可フロー保存先
[[kv_namespaces]]
binding = "OAUTH_KV"
id = "YOUR_OAUTH_KV_NAMESPACE_ID" # wrangler kv namespace create OAUTH_KV で表示されるID

[vars]
# Webhook受信パスのランダム部分: /webhook/withings-{WEBHOOK_PATH_SECRET}
# 例: openssl rand -hex 16
WEBHOOK_PATH_SECRET = "CHANGE_ME_RANDOM_HEX"
# ダッシュボードURLのランダムslug: /d/{DASHBOARD_SLUG}/
# 例: openssl rand -hex 8
# 空文字("")にするとドメイン直下（/）で配信する（専用ドメイン運用向け。
# ホスト名は証明書の透明性ログ等で公開されるため、アクセス制限が必要なら
# Cloudflare Access などをドメインに後付けすること）
DASHBOARD_SLUG = "CHANGE_ME_RANDOM_SLUG"
# 集計・表示のタイムゾーンオフセット（時間）。固定オフセットでDST非対応。既定 9 = JST
TZ_OFFSET_HOURS = "9"
# 読み取りアクセス制御: "public"（既定）= 誰でも閲覧可 / "private" = データの閲覧もオーナーのGoogleログイン必須
# 有効値は public / private のみ。それ以外の値（タイポ等）は安全側（private）に倒れる。未設定・空は public
# private時の注意はREADMEの「アクセス制御」参照（Slack画像用のOG_ACCESS_TOKEN、ChatGPT Actions不可 等）
READ_ACCESS = "public"
# 任意: AIコーチング生成（GitHub Actions）をWorkerの23:30 JST cronから起動する場合、対象リポジトリを指定する。
# GITHUB_DISPATCH_TOKEN（Secret）とセットで有効になる。未設定ならGitHub側のscheduleのみで生成される。
# ここ（[vars]）に書く代わりに `wrangler secret put GITHUB_DISPATCH_REPO` でSecretとして登録してもよい。
# TZ_OFFSET_HOURSを既定（9）から変える場合は、生成ジョブ側のCOACHING_TZ_OFFSET_HOURSも同じ値にすること
# （対象日の計算がずれると、起動された生成ジョブが日付を未来日として拒否する）
# GITHUB_DISPATCH_REPO = "your-github-username/bodylog"

[triggers]
# 5分毎: inbox回収・通知再送・初期インポート再開・日次ダイジェスト送信判定
#   （ダイジェストの送信時刻はD1の settings.digest_time で変更する。再デプロイ不要）
# 20:15 UTC (05:15 JST): 日次バックフィル・掃除・購読確認
crons = ["*/5 * * * *", "15 20 * * *"]

[observability]
enabled = true

[[rules]]
type = "Text"
globs = ["**/*.html", "**/*.css", "**/*.webmanifest", "dashboard/*.js", "dashboard/**/*.js", "**/dashboard/*.js", "**/dashboard/**/*.js"]
fallthrough = false
